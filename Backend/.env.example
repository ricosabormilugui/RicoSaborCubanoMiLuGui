PORT=3001
CORS_ORIGIN=*

AUTH_JWT_SECRET=change_this_secret
ADMIN_EMAIL=admin@milugui.com
ADMIN_PASSWORD=change_this_password

# Usa MONGODB_URI (o MONGO_URI como alias)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=

# Usa MONGODB_DB_NAME (o MONGO_DB_NAME como alias)
MONGODB_DB_NAME=miLuGui
MONGO_DB_NAME=

# Colección de pedidos (ORDERS_COLLECTION también funciona como alias)
MONGODB_ORDERS_COLLECTION=orders
ORDERS_COLLECTION=

RESEND_API_KEY=re_xxxxxxxxxxxxx
NOTIFY_EMAIL_FROM="Pedidos MiLuGui <pedidos@tudominio.com>"
NOTIFY_EMAIL_TO=ventas@tudominio.com

WHATSAPP_ENABLED=false
NOTIFY_WHATSAPP_TO=34600111222

# Activa WhatsApp en entornos con Chrome/Chromium disponible
# (por ejemplo, local con QR). En Render suele dejarse en false.

# Token opcional para proteger /api/whatsapp/notify
WHATSAPP_WEBHOOK_TOKEN=token_compartido_opcional
