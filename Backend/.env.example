PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# JWT / Auth
AUTH_TOKEN_SECRET=change_this_secret
AUTH_JWT_SECRET=

# Admin login
ADMIN_EMAIL=admin@milugui.com
ADMIN_PASSWORD=change_this_password

# MongoDB (puedes usar cualquiera de los dos nombres)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=

# Database name (alias compatible)
MONGODB_DB_NAME=ricoSaborCubano
MONGO_DB_NAME=

# Collections
MONGODB_ORDERS_COLLECTION=orders
MONGODB_PRODUCTS_COLLECTION=products
MONGODB_CONTACTS_COLLECTION=contacts
MONGODB_CUSTOMERS_COLLECTION=customers
ORDERS_COLLECTION=
MONGODB_USERS_COLLECTION=users

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
NOTIFY_EMAIL_FROM="Pedidos MiLuGui <pedidos@tudominio.com>"
NOTIFY_EMAIL_TO=ventas@tudominio.com
