# Backend MIXSABOR. Copia a .env y no subas secretos reales.

# Requeridas
NODE_ENV=development
APP_ENV=development
PORT=3001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=ricoSaborCubano
AUTH_TOKEN_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
FRONTEND_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Email opcional. Si se define una, deben definirse las tres.
RESEND_API_KEY=re_xxxxxxxxxxxxx
NOTIFY_EMAIL_FROM="Pedidos MIXSABOR <pedidos@tudominio.com>"
NOTIFY_EMAIL_TO=ventas@tudominio.com

# Solo staging: redirige TODOS los emails salientes a este buzón QA.
# APP_ENV=production rechaza explícitamente esta variable.
# STAGING_EMAIL_TO=qa-controlado@tudominio.com

# Pago manual. Las cuatro variables son obligatorias en producción.
PAYMENT_BIZUM_PHONE=+34XXXXXXXXX
PAYMENT_BANK_IBAN=ESXXXXXXXXXXXXXXXXXXXXXX
PAYMENT_BANK_HOLDER="Titular de la cuenta"
PAYMENT_CASH_INSTRUCTIONS="Pagar en efectivo al recibir o recoger el pedido."

# Colecciones opcionales
MONGODB_ORDERS_COLLECTION=orders
MONGODB_USERS_COLLECTION=users
MONGODB_PRODUCTS_COLLECTION=products
MONGODB_CATEGORIES_COLLECTION=product_categories
MONGODB_CUSTOMERS_COLLECTION=customers
MONGODB_CONTACTS_COLLECTION=contacts
MONGODB_HOME_COLLECTION=home_settings

# Timeouts, límites y diagnóstico (opcionales; defaults mostrados)
JSON_BODY_LIMIT=1mb
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20
EXTERNAL_HTTP_TIMEOUT_MS=8000
RESEND_TIMEOUT_MS=8000
SLOW_REQUEST_THRESHOLD_MS=2000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
SERVICE_VERSION=1.0.0

# Recuperación (opcionales)
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_RATE_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_MAX_PER_EMAIL=3
PASSWORD_RESET_RATE_MAX_PER_IP=10
