# Copia este archivo a .env y completa valores reales.
# No subas secretos reales al repositorio.

# Netlify: backend público al que reenvía /api/* (requerida en Netlify)
BACKEND_API_URL=https://tu-backend.onrender.com
BACKEND_TIMEOUT_MS=10000

# URL pública del frontend usada para construir enlaces de recuperación.
# En desarrollo puede ser, por ejemplo, http://localhost:4200
FRONTEND_URL=https://mixsabor.milugui.com
CORS_ORIGIN=https://mixsabor.milugui.com

# Backend: requerida, mínimo 32 caracteres. AUTH_JWT_SECRET se acepta como alias.
AUTH_TOKEN_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Recuperación de contraseña (opcionales; se muestran los valores por defecto)
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_RATE_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_MAX_PER_EMAIL=3
PASSWORD_RESET_RATE_MAX_PER_IP=10

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=ricoSaborCubano
MONGODB_ORDERS_COLLECTION=orders
MONGODB_USERS_COLLECTION=users
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=20

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
NOTIFY_EMAIL_FROM="Pedidos MIXSABOR <pedidos@tudominio.com>"
NOTIFY_EMAIL_TO=ventas@tudominio.com
RESEND_TIMEOUT_MS=8000

# Solo staging: APP_ENV=staging exige este buzón y redirige allí todo email saliente.
# No configurar en producción real.
# STAGING_EMAIL_TO=qa-controlado@tudominio.com

# Instrucciones de pago manual. Opcional: bootstrap si aún no existe payment_settings en Mongo.
# La fuente canónica es Admin → Configuración de pagos.
# PAYMENT_BIZUM_PHONE=+34XXXXXXXXX
# PAYMENT_BANK_IBAN=ESXXXXXXXXXXXXXXXXXXXXXX
# PAYMENT_BANK_HOLDER="Titular de la cuenta"
# PAYMENT_CASH_INSTRUCTIONS="Pagar en efectivo al recibir o recoger el pedido."

# Operación (opcionales; se muestran defaults)
NODE_ENV=production
APP_ENV=production
PORT=3001
JSON_BODY_LIMIT=1mb
EXTERNAL_HTTP_TIMEOUT_MS=8000
SLOW_REQUEST_THRESHOLD_MS=2000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
SERVICE_VERSION=1.0.0

# WhatsApp no usa API ni webhook: solo enlace manual wa.me en frontend.
